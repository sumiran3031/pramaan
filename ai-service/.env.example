# =====================================================================
# PRAMAAN AI SERVICE - Environment Variable Reference
# =====================================================================
# Copy this to .env for local development. Never commit a real .env file.
# =====================================================================

ENVIRONMENT=development
AI_SERVICE_PORT=8000

# Path to the Tesseract OCR binary (used in a later phase, once OCR
# is implemented). Leave unset if tesseract is already on your PATH.
# Example (Windows): C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD_PATH=
