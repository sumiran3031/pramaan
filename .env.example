# =====================================================================
# PRAMAAN - Environment Variable Reference (Root)
# =====================================================================
# This file lists ALL environment variables used across the project.
# Copy this to .env and fill in real values for local development.
# NEVER commit a real .env file. Only .env.example files are tracked.
# =====================================================================

# ---------- General ----------
ENVIRONMENT=development

# ---------- Database (MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pramaan
DB_USERNAME=root
DB_PASSWORD=changeme

# ---------- Backend (Spring Boot) ----------
BACKEND_PORT=8080
JWT_SECRET=changeme_generate_a_long_random_secret
JWT_EXPIRATION_MS=3600000

# ---------- AI Service (FastAPI) ----------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# ---------- Frontend (React/Vite) ----------
VITE_API_BASE_URL=http://localhost:8080

# ---------- Government Verification Providers ----------
# All providers are MOCK implementations during development.
# No real credentials exist yet. Do not populate these until an
# authorized integration is in place.
GST_VERIFICATION_MODE=mock
PAN_VERIFICATION_MODE=mock
UDYAM_VERIFICATION_MODE=mock
EPFO_VERIFICATION_MODE=mock
